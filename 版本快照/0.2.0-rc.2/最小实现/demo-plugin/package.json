{
  "name": "@local/demo-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "最小完整插件：一个 agent 工具 + 一条带鉴权的 HTTP 路由 + 一个真实槽位，两半齐全。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["index.js", "client.js", "locale", "cordis.patch.yml"],
  "meta": {
    "title": "Demo Plugin",
    "description": "最小完整插件：工具 + 路由 + 槽位。"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  }
}
